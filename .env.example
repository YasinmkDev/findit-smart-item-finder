# Copy this file to ".env" and fill in your own key. Never commit .env.
# Get a free Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
# Optional - defaults to gemini-3.5-flash (gemini-2.5-flash is no longer
# available to new API users, verified 2026-10-13)
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.5-flash
